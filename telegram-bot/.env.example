# Reference only — Telegram Serverless (tgcloud) does not read .env at
# runtime. Edit `tgcloud/lib/config.js` with the real values, then:
#
#   npx tgcloud login    # CLI access token from @BotFather -> Serverless
#   npx tgcloud push
#
# The bridge engine must be reachable from the public internet:
#   BRIDGE_HOST=0.0.0.0 on your bridge (Docker/VPS), plus TLS in front.
#
# These are the values that go into tgcloud/lib/config.js:
BRIDGE_BASE_URL=https://YOUR-BRIDGE-HOST
BRIDGE_API_KEY=YOUR-BRIDGE-API-KEY
MODEL=mercury-3
SHOW_THINKING=true
