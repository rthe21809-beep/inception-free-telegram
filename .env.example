# inception-free-bridge configuration (copy to `.env` and edit)
# Every variable maps 1:1 to a CLI flag of server.mjs; the flag wins if both
# are given. Values in this file are the same defaults the server uses, so
# you only need to uncomment what you want to change.

# --- network ---------------------------------------------------------------
# 0.0.0.0 to accept connections from other machines (servers / Docker).
# Keep 127.0.0.1 if you only reach the bridge from the same host
# (e.g. via a local reverse proxy on the same machine).
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8890

# --- auth (optional but recommended when exposed) --------------------------
# If set, requests must send `Authorization: Bearer <value>`.
#BRIDGE_API_KEY=change-me

# --- sessions --------------------------------------------------------------
# Credentials file (one or more free-chat sessions). Generated by warmup or
# get-creds — see README "Getting a session".
BRIDGE_CREDS=data/creds.json

# Re-solve the Vercel checkpoint every N hours so sessions never 401.
# 0 = off. 5 is a sane value for a long-running server.
BRIDGE_AUTO_REFRESH=0

# Drop sessions older than this many hours.
#BRIDGE_SESSION_TTL=6

# --- model ------------------------------------------------------------------
BRIDGE_DEFAULT_MODEL=mercury-3
# "mercury" = the platform's own model id (default).
#BRIDGE_UPSTREAM_MODEL=mercury

# --- browser (needed for checkpoint solving + browser-context fallback) -----
# auto  = use chromium only if a binary is found
# on    = always run completions inside the browser page (recommended)
# off   = plain HTTP only (works after warmup, may hit the checkpoint)
BRIDGE_BROWSER=auto
# Path to a chromium/chrome binary. Docs: set it to the path found by
# `npm run doctor`. Example (Debian/Ubuntu): /usr/bin/chromium
#BRIDGE_CHROMIUM=/usr/bin/chromium

# --- thinking ---------------------------------------------------------------
# end  = deliver captured reasoning as one complete block (default, recommended)
# live = forward every reasoning delta as it arrives
# off  = strip reasoning entirely
#BRIDGE_THINKING=end
# Which request field the platform honours for thinking effort. "auto"
# discovers it with a background probe; "reasoning_effort" is the default.
#BRIDGE_EFFORT_FIELD=auto
# Probe at startup to discover levels (extra browser round-trip).
#BRIDGE_DISCOVER_EFFORT=0
